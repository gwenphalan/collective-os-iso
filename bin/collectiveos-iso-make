#!/bin/bash

# Abort if anything fails
set -e

# Parse command line arguments
NO_CACHE=""
while [[ $# -gt 0 ]]; do
  case $1 in
  --no-cache)
    NO_CACHE=1
    shift
    ;;
  --no-boot-offer)
    NO_BOOT_OFFER=1
    shift
    ;;
  --local-source)
    LOCAL_SOURCE=1
    shift
    ;;
  --dev)
    COLLECTIVEOS_INSTALLER_REF=dev
    shift
    ;;
  *)
    echo "Unknown option: $1"
    echo "Usage: $0 [--no-cache] [--no-boot-offer] [--local-source] [--dev]"
    exit 1
    ;;
  esac
done

# Ensure we have the submodule checked out
git submodule update --init --recursive --jobs=8

# Prepare build repo
BUILD_SCRIPT="builder/build-iso.sh"
BUILD_ROOT=$(realpath "${BASH_SOURCE[0]%/*}/..")
BUILD_RELEASE_PATH="$BUILD_ROOT/release"
mkdir -p "$BUILD_RELEASE_PATH"

COLLECTIVEOS_INSTALLER_REPO="${COLLECTIVEOS_INSTALLER_REPO:-gwenphalan/collective-os}"
COLLECTIVEOS_INSTALLER_REF="${COLLECTIVEOS_INSTALLER_REF:-main}"

DOCKER_ARGS=(
  --rm
  --privileged
  -e "COLLECTIVEOS_INSTALLER_REPO=$COLLECTIVEOS_INSTALLER_REPO"
  -e "COLLECTIVEOS_INSTALLER_REF=$COLLECTIVEOS_INSTALLER_REF"
  -e "HOST_UID=$(id -u)"
  -e "HOST_GID=$(id -g)"
  -v "$BUILD_RELEASE_PATH/:/out/"
  -v "$BUILD_ROOT/$BUILD_SCRIPT:/$BUILD_SCRIPT:ro"
  -v "$BUILD_ROOT/archiso:/archiso:ro"
  -v "$BUILD_ROOT/builder:/builder:ro"
  -v "$BUILD_ROOT/configs:/configs:ro"
)

# Use local source of CollectiveOS from $COLLECTIVEOS_PATH instead of git checkout
if [[ -n "${LOCAL_SOURCE-}" ]]; then
  if [[ -z "${COLLECTIVEOS_PATH:-}" ]]; then
    if [[ -d "$HOME/collective-os" ]]; then
      COLLECTIVEOS_PATH="$HOME/collective-os"
    else
      echo "COLLECTIVEOS_PATH must point to your local collective-os checkout when using --local-source" >&2
      exit 1
    fi
  fi

  if [[ ! -d "$COLLECTIVEOS_PATH" ]]; then
    echo "COLLECTIVEOS_PATH does not exist: $COLLECTIVEOS_PATH" >&2
    exit 1
  fi

  DOCKER_ARGS+=(-v "$COLLECTIVEOS_PATH:/collectiveos:ro")
fi

# Use local pacman cache if you already have one on host to speed up repeat runs
if [ -d "/var/cache/pacman/pkg" ]; then
  DOCKER_ARGS+=(-v "/var/cache/pacman/pkg:/var/cache/pacman/pkg")
fi

# Mount the build cache directory where packages are downloaded
if [[ -z "$NO_CACHE" ]]; then
  # using a dated dir on the host to refresh daily if building multiple times
  BUILD_DATE=$(date +%Y-%m-%d)
  OFFLINE_REPO_BUILD_CACHE_DIR="$HOME/.cache/collectiveos/iso_${BUILD_DATE}/airootfs/var/cache/collectiveos"
  mkdir -p "$OFFLINE_REPO_BUILD_CACHE_DIR"
  # Mount to /var/cache/airootfs/var/cache/collectiveos since that's where repo packages go in the ISO
  DOCKER_ARGS+=(-v "$OFFLINE_REPO_BUILD_CACHE_DIR:/var/cache/airootfs/var/cache/collectiveos")
fi

# Run the builder with assembled args
docker run "${DOCKER_ARGS[@]}" archlinux/archlinux:latest /$BUILD_SCRIPT

# Move as install ref
latest_iso=$(\ls -t "$BUILD_RELEASE_PATH"/*.iso | head -n1)
iso_ref="${latest_iso%.*}-$COLLECTIVEOS_INSTALLER_REF.iso"
mv -f "$latest_iso" "$iso_ref"

# Offer to boot the new build
if [[ -z "$NO_BOOT_OFFER" ]]; then
  echo
  gum confirm "Boot $iso_ref?" && collectiveos-iso-boot "$iso_ref"
fi
