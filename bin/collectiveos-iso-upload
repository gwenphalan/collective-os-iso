#!/bin/bash

if [ $# -eq 0 ]; then
  echo "Usage: collectiveos-iso-upload [release/collectiveos.iso]"
  exit 1
fi

if [[ ! -f ~/.config/rclone/rclone.conf ]]; then
  echo "You must first configure rclone with the R2 credentials: collectiveos-iso-rclone-config"
  exit 1
fi

RCLONE_REMOTE_NAME="${COLLECTIVEOS_RCLONE_REMOTE:-CollectiveOS}"
RCLONE_PREFIX="${COLLECTIVEOS_RCLONE_PREFIX:-collectiveos}"

rclone copy "$1" "$RCLONE_REMOTE_NAME:$RCLONE_PREFIX/" -P

if [[ -f "$1.sig" ]]; then
  rclone copy "$1.sig" "$RCLONE_REMOTE_NAME:$RCLONE_PREFIX/" -P
fi
